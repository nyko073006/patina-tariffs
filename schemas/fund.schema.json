{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patina-tariffs.example/schemas/fund.schema.json",
  "title": "Fund",
  "description": "Investmentfonds oder ETF",
  "type": "object",
  "additionalProperties": false,
  "required": ["isin", "name", "provider", "assetClass", "ter", "currency", "fundType", "distribution"],
  "properties": {
    "isin": {
      "type": "string",
      "pattern": "^[A-Z]{2}[A-Z0-9]{9}[0-9]$",
      "description": "ISO 6166 ISIN; dient als Primärschlüssel und Dateiname"
    },
    "wkn": {
      "type": "string",
      "pattern": "^[A-Z0-9]{6}$"
    },
    "name": { "type": "string", "minLength": 3 },
    "provider": { "type": "string", "minLength": 2 },
    "fundType": { "enum": ["etf", "mutual-fund"] },
    "assetClass": {
      "enum": ["equity", "bond", "mixed", "commodity", "money-market", "real-estate"]
    },
    "region": { "type": "string" },
    "index": { "type": "string" },
    "ter": {
      "type": "number",
      "minimum": 0,
      "maximum": 5,
      "description": "Total Expense Ratio in % p.a."
    },
    "replicationMethod": { "enum": ["physical-full", "physical-sampling", "synthetic"] },
    "distribution": { "enum": ["distributing", "accumulating"] },
    "domicile": { "type": "string", "pattern": "^[A-Z]{2}$" },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "fundSize": {
      "type": "number",
      "minimum": 0,
      "description": "Fondsvolumen in EUR"
    },
    "inception": { "type": "string", "format": "date" },
    "sfdr": { "enum": ["Art. 6", "Art. 8", "Art. 9"] },
    "documents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "factsheet": { "type": "string", "format": "uri" },
        "kid": { "type": "string", "format": "uri" },
        "prospectus": { "type": "string", "format": "uri" }
      }
    },
    "tags": { "type": "array", "items": { "type": "string" } },

    "latestPrice": { "type": "number", "minimum": 0 },
    "latestPriceDate": { "type": "string", "format": "date" },
    "latestPriceCurrency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "nav": { "type": "number", "minimum": 0 },
    "navDate": { "type": "string", "format": "date" },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "description": "Total-Return-Performance in % (basierend auf adjusted close).",
      "properties": {
        "m1": { "type": "number" },
        "m3": { "type": "number" },
        "m6": { "type": "number" },
        "ytd": { "type": "number" },
        "y1": { "type": "number" },
        "y3": { "type": "number" },
        "y5": { "type": "number" },
        "y10": { "type": "number" }
      }
    },
    "sectorAllocation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "weight"],
        "properties": {
          "name": { "type": "string" },
          "weight": { "type": "number", "minimum": 0, "maximum": 100 }
        }
      }
    },
    "countryAllocation": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "weight"],
        "properties": {
          "name": { "type": "string" },
          "weight": { "type": "number", "minimum": 0, "maximum": 100 }
        }
      }
    },
    "topHoldings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "weight"],
        "properties": {
          "name": { "type": "string" },
          "weight": { "type": "number", "minimum": 0, "maximum": 100 },
          "isin": { "type": "string", "pattern": "^[A-Z]{2}[A-Z0-9]{9}[0-9]$" },
          "ticker": { "type": "string" }
        }
      }
    },
    "yield": {
      "type": "object",
      "additionalProperties": false,
      "description": "Ausschüttungskennzahlen (für distributing Funds).",
      "properties": {
        "dividendYield": { "type": "number" },
        "yield12m": { "type": "number" }
      }
    },
    "_eodhdSymbol": {
      "type": "string",
      "description": "Gecachter EODHD-Symbol-Lookup (z. B. IE00B4L5Y983.XETRA) — vom Sync-Skript befüllt."
    }
  }
}
