{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patina-tariffs.example/schemas/credit.schema.json",
  "title": "CreditProduct",
  "description": "Kreditprodukt (Baufinanzierung, Ratenkredit)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "provider", "name"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,}$" },
    "type": { "enum": ["mortgage", "installment", "personal"] },
    "provider": { "type": "string", "minLength": 2 },
    "name": { "type": "string", "minLength": 2 },
    "minAmount": { "type": "number", "minimum": 0 },
    "maxAmount": { "type": "number", "minimum": 0 },
    "minTermMonths": { "type": "integer", "minimum": 1 },
    "maxTermMonths": { "type": "integer", "minimum": 1 },
    "effectiveRate": {
      "type": "object",
      "additionalProperties": false,
      "description": "Effektivzins in % p.a., repräsentativer Bereich",
      "properties": {
        "from": { "type": "number", "minimum": 0, "maximum": 30 },
        "to": { "type": "number", "minimum": 0, "maximum": 30 }
      }
    },
    "fixationPeriodsYears": {
      "type": "array",
      "items": { "type": "integer", "minimum": 1, "maximum": 40 },
      "description": "Verfügbare Zinsbindungen (nur Baufi)"
    },
    "maxLtv": {
      "type": "number",
      "minimum": 0,
      "maximum": 130,
      "description": "Maximaler Beleihungsauslauf in % (nur Baufi)"
    },
    "features": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } }
  }
}
