{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patina-tariffs.example/schemas/insurance.schema.json",
  "title": "InsuranceTariff",
  "description": "Versicherungstarif (LV, BU, KV, Sach)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "category", "provider", "name"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,}$",
      "description": "kebab-case ID, eindeutig pro Kategorie; dient als Dateiname"
    },
    "category": {
      "enum": ["life", "occupational-disability", "health", "property", "liability", "accident", "car"]
    },
    "provider": { "type": "string", "minLength": 2 },
    "name": { "type": "string", "minLength": 2 },
    "shortDescription": { "type": "string", "maxLength": 400 },
    "minPremium": {
      "type": "number",
      "minimum": 0,
      "description": "Mindestbeitrag in EUR/Monat"
    },
    "entryAge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min": { "type": "integer", "minimum": 0, "maximum": 100 },
        "max": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "term": {
      "type": "object",
      "additionalProperties": false,
      "description": "Laufzeit in Jahren",
      "properties": {
        "min": { "type": "integer", "minimum": 0 },
        "max": { "type": "integer", "minimum": 0 }
      }
    },
    "features": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Leistungsmerkmale, frei wählbar"
    },
    "documents": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "conditions": { "type": "string", "format": "uri" },
        "productSheet": { "type": "string", "format": "uri" }
      }
    },
    "ratings": {
      "type": "array",
      "description": "Referenzen auf rating-IDs",
      "items": { "type": "string" }
    },
    "tags": { "type": "array", "items": { "type": "string" } }
  }
}
