{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://patina-tariffs.example/schemas/rating.schema.json",
  "title": "Rating",
  "description": "Externes Rating (Franke & Bornberg, Morningstar, Scope, Stiftung Warentest)",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "source", "targetType", "targetId", "rating", "ratingDate"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,}$" },
    "source": {
      "enum": ["franke-bornberg", "morningstar", "scope", "map-report", "stiftung-warentest", "assekurata"]
    },
    "targetType": { "enum": ["fund", "insurance", "credit"] },
    "targetId": { "type": "string" },
    "rating": { "type": "string", "description": "Original-Rating-String, z. B. 'FFF+', '5 Sterne', 'sehr gut'" },
    "ratingNumeric": {
      "type": "number",
      "minimum": 0,
      "maximum": 10,
      "description": "Normierter Zahlenwert für Sortierung (optional)"
    },
    "ratingDate": { "type": "string", "format": "date" },
    "url": { "type": "string", "format": "uri" },
    "notes": { "type": "string" }
  }
}
