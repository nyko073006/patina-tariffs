---
import Base from "../../layouts/Base.astro";
import { credit, CREDIT_TYPE_LABELS, formatEur, formatPercent } from "../../lib/data";

export function getStaticPaths() {
  return credit.map((c) => ({ params: { id: c.id }, props: { product: c } }));
}
const { product } = Astro.props;
---
<Base title={product.name}>
  <section class="mx-auto max-w-5xl px-4 pt-8 pb-12">
    <a href="/kredite/" class="text-sm text-ink-500 no-underline hover:text-ink-700">← zurück zur Liste</a>
    <div class="mt-2 flex items-start justify-between gap-6 flex-wrap">
      <div>
        <div class="flex flex-wrap gap-2 mb-2">
          <span class="chip chip-accent">{CREDIT_TYPE_LABELS[product.type]}</span>
          {product.tags?.map((t) => <span class="chip">{t}</span>)}
        </div>
        <h1 class="text-2xl font-semibold tracking-tight">{product.name}</h1>
        <p class="text-ink-500 text-sm mt-1">{product.provider} · {product.id}</p>
      </div>
      <a href={`/vergleich/?add=${product.id}`} class="btn">Zum Vergleich</a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-6">
      {product.effectiveRate && (
        <div class="card p-4">
          <div class="label">Effektivzins p. a.</div>
          <div class="text-2xl font-light mt-1 tabular-nums">
            {formatPercent(product.effectiveRate.from ?? 0)} – {formatPercent(product.effectiveRate.to ?? 0)}
          </div>
        </div>
      )}
      {product.minAmount !== undefined && (
        <div class="card p-4">
          <div class="label">Kreditsumme</div>
          <div class="text-2xl font-light mt-1 tabular-nums">{formatEur(product.minAmount)} – {formatEur(product.maxAmount ?? 0)}</div>
        </div>
      )}
      {product.minTermMonths && (
        <div class="card p-4">
          <div class="label">Laufzeit</div>
          <div class="text-2xl font-light mt-1 tabular-nums">{product.minTermMonths}–{product.maxTermMonths} <span class="text-sm text-ink-500">Monate</span></div>
        </div>
      )}
    </div>

    {product.fixationPeriodsYears && product.fixationPeriodsYears.length > 0 && (
      <div class="card mt-6 p-4">
        <h2 class="font-semibold">Zinsbindungen</h2>
        <div class="mt-2 flex flex-wrap gap-2">
          {product.fixationPeriodsYears.map((y) => <span class="chip">{y} Jahre</span>)}
        </div>
      </div>
    )}

    {product.features && product.features.length > 0 && (
      <div class="card mt-6 p-5">
        <h2 class="font-semibold">Konditionen &amp; Optionen</h2>
        <ul class="mt-3 space-y-2 text-sm">
          {product.features.map((f) => (
            <li class="flex gap-2"><span class="text-accent-500">✓</span><span>{f}</span></li>
          ))}
        </ul>
      </div>
    )}
  </section>
</Base>
