---
import Base from "../layouts/Base.astro";
import { bundle } from "../lib/data";
const cards = [
  { href: "/fonds/", title: "Fonds & ETFs", count: bundle.counts.funds, hint: "ISIN-Suche, TER, Replikation, Region" },
  { href: "/tarife/", title: "Versicherungstarife", count: bundle.counts.insurance, hint: "LV, BU, Kranken, Sach, Haftpflicht" },
  { href: "/kredite/", title: "Kredite", count: bundle.counts.credit, hint: "Baufi, Ratenkredit, Effektivzins" },
  { href: "/vergleich/", title: "Vergleich", count: null, hint: "bis zu 3 Produkte nebeneinander" },
];
---
<Base title="Übersicht">
  <section class="mx-auto max-w-7xl px-4 pt-12 pb-6">
    <h1 class="text-3xl font-semibold tracking-tight">Tarif- &amp; Produktdatenbank</h1>
    <p class="mt-3 max-w-2xl text-ink-600">
      Eine durchsuchbare Datenbank für Versicherungstarife, Fonds, Kreditprodukte und externe Ratings — gepflegt im Git-Repository
      <code class="text-ink-700">patina-tariffs</code>, gebaut für den Einsatz im Vermittler-Workflow.
    </p>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-12">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {cards.map((c) => (
        <a href={c.href} class="card p-5 hover:border-accent-500 hover:shadow-sm transition no-underline text-ink-900">
          <div class="flex items-baseline justify-between">
            <h2 class="font-semibold">{c.title}</h2>
            {c.count !== null && <span class="text-2xl font-light text-ink-500">{c.count}</span>}
          </div>
          <p class="text-sm text-ink-500 mt-2">{c.hint}</p>
        </a>
      ))}
    </div>

    <div class="card mt-10 p-6">
      <h3 class="font-semibold">Aktualisierung &amp; Pflege</h3>
      <ol class="mt-3 space-y-2 text-sm text-ink-700 list-decimal pl-5">
        <li>Datei in <code>data/&lt;art&gt;/&lt;id&gt;.json</code> anlegen oder ändern.</li>
        <li>Pull Request öffnen — CI validiert das Schema und prüft Cross-Refs (z. B. Ratings → Tarife).</li>
        <li>Nach Merge baut die Action das <code>dist/</code>-Bundle und deployt die Website.</li>
      </ol>
      <p class="mt-3 text-xs text-ink-500">
        Schemas: <code>schemas/{ "{fund,insurance,credit,rating}.schema.json" }</code> ·
        Build: <code>npm run build</code> · Validierung: <code>npm run validate</code>.
      </p>
    </div>
  </section>
</Base>
