---
import Base from "../../layouts/Base.astro";
import { funds, ASSET_CLASS_LABELS, formatPercent, formatEur, formatDate } from "../../lib/data";

export function getStaticPaths() {
  return funds.map((f) => ({ params: { isin: f.isin }, props: { fund: f } }));
}

const { fund } = Astro.props;

const meta: Array<[string, string | number | undefined]> = [
  ["ISIN", fund.isin],
  ["WKN", fund.wkn],
  ["Anbieter", fund.provider],
  ["Anlageklasse", ASSET_CLASS_LABELS[fund.assetClass] ?? fund.assetClass],
  ["Region", fund.region],
  ["Index", fund.index],
  ["TER (% p. a.)", formatPercent(fund.ter)],
  ["Replikation", fund.replicationMethod ?? "—"],
  ["Ausschüttung", fund.distribution === "accumulating" ? "thesaurierend" : "ausschüttend"],
  ["Fondsdomizil", fund.domicile],
  ["Fondswährung", fund.currency],
  ["Fondsgröße", fund.fundSize ? formatEur(fund.fundSize) : undefined],
  ["Auflagedatum", fund.inception ? formatDate(fund.inception) : undefined],
  ["SFDR", fund.sfdr],
];
---
<Base title={fund.name}>
  <section class="mx-auto max-w-5xl px-4 pt-8 pb-12">
    <a href="/fonds/" class="text-sm text-ink-500 no-underline hover:text-ink-700">← zurück zur Liste</a>
    <div class="mt-2 flex items-start justify-between gap-6 flex-wrap">
      <div>
        <div class="flex flex-wrap gap-2 mb-2">
          <span class="chip chip-accent">{fund.fundType === "etf" ? "ETF" : "Fonds"}</span>
          <span class="chip">{ASSET_CLASS_LABELS[fund.assetClass] ?? fund.assetClass}</span>
          {fund.tags?.map((t) => <span class="chip">{t}</span>)}
        </div>
        <h1 class="text-2xl font-semibold tracking-tight">{fund.name}</h1>
        <p class="text-ink-500 text-sm mt-1">{fund.provider} · {fund.isin}{fund.wkn ? ` · WKN ${fund.wkn}` : ""}</p>
      </div>
      <div class="flex gap-2">
        <a href={`/vergleich/?add=${fund.isin}`} class="btn">Zum Vergleich</a>
        <button class="btn" type="button" onclick="window.print()">Drucken / PDF</button>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-6">
      <div class="card p-4">
        <div class="label">TER</div>
        <div class="text-2xl font-light mt-1 tabular-nums">{formatPercent(fund.ter)}</div>
      </div>
      <div class="card p-4">
        <div class="label">Fondsvolumen</div>
        <div class="text-2xl font-light mt-1 tabular-nums">
          {fund.fundSize ? formatEur(fund.fundSize, { notation: "compact" }) : "—"}
        </div>
      </div>
      <div class="card p-4">
        <div class="label">Auflagejahr</div>
        <div class="text-2xl font-light mt-1 tabular-nums">
          {fund.inception ? fund.inception.slice(0, 4) : "—"}
        </div>
      </div>
    </div>

    <div class="card mt-6 overflow-hidden">
      <table class="w-full text-sm">
        <tbody>
          {meta.filter(([, v]) => v !== undefined && v !== null && v !== "").map(([k, v]) => (
            <tr class="border-t border-ink-100 first:border-t-0">
              <th class="px-4 py-2 text-left text-ink-500 font-normal w-1/3">{k}</th>
              <td class="px-4 py-2 text-ink-900">{v}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    {fund._ratings && fund._ratings.length > 0 && (
      <div class="card mt-6 p-4">
        <h2 class="font-semibold">Externe Ratings</h2>
        <ul class="mt-3 divide-y divide-ink-100">
          {fund._ratings.map((r) => (
            <li class="py-2 flex items-center justify-between text-sm">
              <span class="text-ink-700">{r.source}</span>
              <span class="font-medium">{r.rating}</span>
              <span class="text-ink-500 tabular-nums">{formatDate(r.ratingDate)}</span>
            </li>
          ))}
        </ul>
      </div>
    )}

    {fund.documents && Object.keys(fund.documents).length > 0 && (
      <div class="card mt-6 p-4">
        <h2 class="font-semibold">Dokumente</h2>
        <ul class="mt-3 space-y-1 text-sm">
          {Object.entries(fund.documents).map(([k, v]) => (
            <li><a href={v} target="_blank" rel="noopener">{k}</a></li>
          ))}
        </ul>
      </div>
    )}
  </section>
</Base>
