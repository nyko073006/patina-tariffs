---
import Base from "../../layouts/Base.astro";
import { insurance, INSURANCE_CATEGORY_LABELS, formatEur } from "../../lib/data";

const categories = [...new Set(insurance.map((i) => i.category))];
const providers = [...new Set(insurance.map((i) => i.provider))].sort();

function netTariffAvailable(i: typeof insurance[number]) {
  return i.scenarios?.some((s) => s.id === "net-tariff") ?? false;
}
---
<Base title="Versicherungstarife">
  <section class="mx-auto max-w-7xl px-4 pt-8 pb-6">
    <div class="flex items-end justify-between gap-4 flex-wrap">
      <div>
        <h1 class="text-2xl font-semibold tracking-tight">Versicherungstarife</h1>
        <p class="text-sm text-ink-500 mt-1">
          <span id="result-count">{insurance.length}</span> von {insurance.length} Tarifen
        </p>
      </div>
      <div class="flex gap-2 flex-wrap">
        <input id="q" type="search" placeholder="Tarifname, Anbieter, Merkmal …" class="input w-80" autocomplete="off" />
        <select id="sort" class="input">
          <option value="">Sortierung: Standard</option>
          <option value="ec-asc">Effektivkosten ↑</option>
          <option value="annuity-desc">Rentenfaktor ↓</option>
          <option value="etf-desc">ETF-Anzahl ↓</option>
          <option value="premium-asc">Mindestbeitrag ↑</option>
        </select>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 grid grid-cols-1 lg:grid-cols-[260px_1fr] gap-6">
    <aside class="card p-4 h-fit lg:sticky lg:top-20 space-y-5">
      <div>
        <h2 class="font-semibold text-sm">Filter</h2>
      </div>
      <div>
        <div class="label mb-1">Sparte</div>
        {categories.map((c) => (
          <label class="flex items-center gap-2 py-0.5 text-sm">
            <input type="checkbox" class="filter" data-key="category" value={c} />
            <span>{INSURANCE_CATEGORY_LABELS[c]}</span>
          </label>
        ))}
      </div>
      <div>
        <div class="label mb-1">Anbieter</div>
        <div class="max-h-48 overflow-y-auto pr-1">
          {providers.map((p) => (
            <label class="flex items-center gap-2 py-0.5 text-sm">
              <input type="checkbox" class="filter" data-key="provider" value={p} />
              <span>{p}</span>
            </label>
          ))}
        </div>
      </div>

      <details class="border-t border-ink-100 pt-4" open>
        <summary class="label cursor-pointer select-none">Fondspolicen-Details</summary>
        <div class="mt-3 space-y-3 text-sm">
          <div>
            <label class="text-xs flex justify-between">
              <span>Effektivkosten max.</span>
              <span><span id="ec-val">3,0</span> %</span>
            </label>
            <input id="ec-range" type="range" min="0.5" max="3" step="0.1" value="3" class="w-full" />
          </div>
          <div>
            <label class="text-xs flex justify-between">
              <span>Rentenfaktor min.</span>
              <span>≥ <span id="af-val">0</span></span>
            </label>
            <input id="af-range" type="range" min="0" max="30" step="1" value="0" class="w-full" />
          </div>
          <div>
            <label class="text-xs flex justify-between">
              <span>ETF-Auswahl min.</span>
              <span>≥ <span id="etf-val">0</span></span>
            </label>
            <input id="etf-range" type="range" min="0" max="70" step="5" value="0" class="w-full" />
          </div>
          <label class="flex items-center gap-2">
            <input id="sustainable" type="checkbox" />
            <span class="text-sm">Nachhaltige Fonds verfügbar</span>
          </label>
          <label class="flex items-center gap-2">
            <input id="net-tariff" type="checkbox" />
            <span class="text-sm">Nettopolice verfügbar</span>
          </label>
          <p id="fp-hint" class="text-xs text-ink-500 hidden">Filter zeigt nur Fondspolicen.</p>
        </div>
      </details>

      <button id="reset" type="button" class="btn w-full">Filter zurücksetzen</button>
    </aside>

    <div>
      <div id="rows" class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {insurance.map((i) => (
          <article
            class="ins-card card p-4 hover:border-accent-500 transition"
            data-name={i.name.toLowerCase()}
            data-provider={i.provider}
            data-category={i.category}
            data-features={(i.features ?? []).join(" ").toLowerCase()}
            data-effective-cost={i.effectiveCost ?? ""}
            data-annuity-factor={i.guaranteedAnnuityFactor ?? ""}
            data-etf-count={i.fundSelection?.etfCount ?? ""}
            data-sustainable={i.fundSelection?.sustainableAvailable ? "1" : ""}
            data-net-tariff={netTariffAvailable(i) ? "1" : ""}
            data-min-premium={i.minPremium ?? ""}
            data-is-fondspolice={i.effectiveCost !== undefined ? "1" : ""}
          >
            <div class="flex items-baseline justify-between gap-2">
              <span class="chip chip-accent">{INSURANCE_CATEGORY_LABELS[i.category]}</span>
              {i.minPremium && <span class="text-xs text-ink-500">ab {formatEur(i.minPremium)}/Mon.</span>}
            </div>
            <h2 class="mt-2 font-semibold leading-tight">
              <a href={`/tarife/${i.id}/`}>{i.name}</a>
            </h2>
            <p class="text-xs text-ink-500">{i.provider}</p>
            {i.shortDescription && <p class="mt-2 text-sm text-ink-700 line-clamp-3">{i.shortDescription}</p>}

            {i.effectiveCost !== undefined && (
              <dl class="mt-3 grid grid-cols-3 gap-2 text-xs">
                <div>
                  <dt class="text-ink-500">Effektivkosten</dt>
                  <dd class="font-medium">{i.effectiveCost.toFixed(2).replace(".", ",")} %</dd>
                </div>
                {i.guaranteedAnnuityFactor && (
                  <div>
                    <dt class="text-ink-500">Rentenfaktor</dt>
                    <dd class="font-medium">{i.guaranteedAnnuityFactor}</dd>
                  </div>
                )}
                {i.fundSelection?.etfCount !== undefined && (
                  <div>
                    <dt class="text-ink-500">ETFs</dt>
                    <dd class="font-medium">{i.fundSelection.etfCount}</dd>
                  </div>
                )}
              </dl>
            )}

            {i.features && i.features.length > 0 && i.effectiveCost === undefined && (
              <ul class="mt-3 space-y-1 text-xs text-ink-700">
                {i.features.slice(0, 3).map((f) => (
                  <li class="flex gap-1.5"><span class="text-accent-500">✓</span><span>{f}</span></li>
                ))}
              </ul>
            )}

            {i._ratings && i._ratings.length > 0 && (
              <div class="mt-3 pt-3 border-t border-ink-100 text-xs text-ink-600">
                {i._ratings[0].source}: <span class="font-medium">{i._ratings[0].rating}</span>
              </div>
            )}
          </article>
        ))}
      </div>
      <p id="empty" class="hidden text-center text-ink-500 py-12">Keine Tarife passen zu deinen Filtern.</p>
    </div>
  </section>
</Base>

<script>
  const grid = document.getElementById("rows")!;
  const cards = Array.from(document.querySelectorAll<HTMLElement>(".ins-card"));
  const q = document.getElementById("q") as HTMLInputElement;
  const filters = Array.from(document.querySelectorAll<HTMLInputElement>(".filter"));
  const count = document.getElementById("result-count")!;
  const empty = document.getElementById("empty")!;
  const reset = document.getElementById("reset")!;
  const sort = document.getElementById("sort") as HTMLSelectElement;
  const ecRange = document.getElementById("ec-range") as HTMLInputElement;
  const afRange = document.getElementById("af-range") as HTMLInputElement;
  const etfRange = document.getElementById("etf-range") as HTMLInputElement;
  const ecVal = document.getElementById("ec-val")!;
  const afVal = document.getElementById("af-val")!;
  const etfVal = document.getElementById("etf-val")!;
  const sustainable = document.getElementById("sustainable") as HTMLInputElement;
  const netTariff = document.getElementById("net-tariff") as HTMLInputElement;
  const fpHint = document.getElementById("fp-hint")!;

  function num(s: string | undefined): number | null {
    if (s === undefined || s === "") return null;
    const n = parseFloat(s);
    return Number.isFinite(n) ? n : null;
  }

  function apply() {
    const query = q.value.trim().toLowerCase();
    const groups: Record<string, string[]> = {};
    for (const f of filters) if (f.checked) (groups[f.dataset.key!] ||= []).push(f.value);

    const ec = parseFloat(ecRange.value);
    const af = parseFloat(afRange.value);
    const etf = parseFloat(etfRange.value);
    ecVal.textContent = ec.toFixed(1).replace(".", ",");
    afVal.textContent = String(af);
    etfVal.textContent = String(etf);

    const fpActive = ec < 3 || af > 0 || etf > 0 || sustainable.checked || netTariff.checked;
    fpHint.classList.toggle("hidden", !fpActive);

    let visible = 0;
    for (const c of cards) {
      let show = true;
      const ds = c.dataset;
      if (query) {
        const hay = `${ds.name} ${ds.provider} ${ds.features}`.toLowerCase();
        if (!hay.includes(query)) show = false;
      }
      if (show) for (const [k, vals] of Object.entries(groups)) {
        if (!vals.includes(ds[k as keyof DOMStringMap] as string)) { show = false; break; }
      }
      if (show && fpActive) {
        if (ds.isFondspolice !== "1") show = false;
        else {
          const cardEc = num(ds.effectiveCost);
          const cardAf = num(ds.annuityFactor);
          const cardEtf = num(ds.etfCount);
          if (cardEc !== null && cardEc > ec) show = false;
          if (show && af > 0 && (cardAf === null || cardAf < af)) show = false;
          if (show && etf > 0 && (cardEtf === null || cardEtf < etf)) show = false;
          if (show && sustainable.checked && ds.sustainable !== "1") show = false;
          if (show && netTariff.checked && ds.netTariff !== "1") show = false;
        }
      }
      c.classList.toggle("hidden", !show);
      if (show) visible++;
    }

    const mode = sort.value;
    if (mode) {
      const visibleCards = cards.filter((c) => !c.classList.contains("hidden"));
      const key = mode === "ec-asc" ? "effectiveCost"
        : mode === "annuity-desc" ? "annuityFactor"
        : mode === "etf-desc" ? "etfCount"
        : mode === "premium-asc" ? "minPremium"
        : null;
      const dir = mode === "ec-asc" || mode === "premium-asc" ? 1 : -1;
      if (key) {
        visibleCards.sort((a, b) => {
          const va = num(a.dataset[key as keyof DOMStringMap] as string);
          const vb = num(b.dataset[key as keyof DOMStringMap] as string);
          if (va === null && vb === null) return 0;
          if (va === null) return 1;
          if (vb === null) return -1;
          return (va - vb) * dir;
        });
        for (const c of visibleCards) grid.appendChild(c);
      }
    }

    count.textContent = String(visible);
    empty.classList.toggle("hidden", visible !== 0);
  }

  q.addEventListener("input", apply);
  sort.addEventListener("change", apply);
  filters.forEach((f) => f.addEventListener("change", apply));
  for (const el of [ecRange, afRange, etfRange]) el.addEventListener("input", apply);
  sustainable.addEventListener("change", apply);
  netTariff.addEventListener("change", apply);
  reset.addEventListener("click", () => {
    q.value = "";
    sort.value = "";
    filters.forEach((f) => (f.checked = false));
    ecRange.value = "3";
    afRange.value = "0";
    etfRange.value = "0";
    sustainable.checked = false;
    netTariff.checked = false;
    apply();
  });
  apply();
</script>
